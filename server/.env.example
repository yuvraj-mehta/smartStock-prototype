# Copy this file to .env for local development.

# Database Configuration
MONGO_URI=mongodb://localhost:27017/smartstock
DB_NAME=smartstock

# Server Configuration
PORT=3500
NODE_ENV=development
# Use loopback or 1 when the API is behind Nginx on the same Droplet.
TRUST_PROXY=false

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_EXPIRATION=7d

# Development seed controls
# Set to 1 only for local development when running seed:*:dev scripts.
# Leave unset/0 for shared, staging, and production databases.
ALLOW_DEV_SEED_CREDENTIALS=0

# Admin bootstrap
# Used by npm run seed:admin and npm run create-admin.
# Set ADMIN_PASSWORD to a unique value with at least 12 characters for any shared database.
# Leave it commented for local-only npm run seed:admin:dev defaults.
ADMIN_EMAIL=admin@smartstock.local
# ADMIN_PASSWORD=replace-with-unique-admin-password
ADMIN_FULL_NAME=Admin User
ADMIN_PHONE=0000000000
ADMIN_WAREHOUSE_NAME=Admin Warehouse
ADMIN_WAREHOUSE_CAPACITY=10000
ADMIN_WAREHOUSE_UNIT=pcs
ADMIN_WAREHOUSE_STREET=123 Admin St
ADMIN_WAREHOUSE_CITY=Admin City
ADMIN_WAREHOUSE_STATE=Admin State
ADMIN_WAREHOUSE_ZIPCODE=00000
ADMIN_WAREHOUSE_COUNTRY=Adminland

# Product seed supplier
# Used by npm run seed:products and npm run seed.
# Set SEED_SUPPLIER_PASSWORD to a unique value with at least 12 characters for any shared database.
SEED_SUPPLIER_NAME=SmartStock Seed Supplier
SEED_SUPPLIER_COMPANY=SmartStock Seed Supplies
SEED_SUPPLIER_EMAIL=supplier@smartstock.local
# SEED_SUPPLIER_PASSWORD=replace-with-unique-supplier-password
SEED_SUPPLIER_PHONE=1111111111
SEED_SUPPLIER_ADDRESS=Seed supplier address
SEED_SUPPLIER_CONTACT=Seed Contact

# Demo usage seed transporter
# Used by npm run seed:demo-usage:dev.
# Set SEED_TRANSPORTER_PASSWORD to a unique value with at least 12 characters for any shared database.
SEED_TRANSPORTER_NAME=Aarav Logistics Lead
SEED_TRANSPORTER_COMPANY=RapidRider Logistics
SEED_TRANSPORTER_EMAIL=transporter@smartstock.local
# SEED_TRANSPORTER_PASSWORD=replace-with-unique-transporter-password
SEED_TRANSPORTER_PHONE=2222222222
SEED_TRANSPORTER_ADDRESS=42 Dispatch Park, Mumbai
SEED_TRANSPORTER_CONTACT=Aarav Mehta

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=replace-with-email-app-password

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Database clear safety controls
# Prefer command flags. These env vars exist for automation that cannot pass script arguments.
# Add deployed or shared DB names here so clearDatabase refuses them unless CLEAR_DATABASE_ALLOW_PROTECTED=1 is explicit.
CLEAR_DATABASE_EXECUTE=0
CLEAR_DATABASE_CONFIRM_DB=
CLEAR_DATABASE_PROTECTED_NAMES=
CLEAR_DATABASE_ALLOW_PROTECTED=0
CLEAR_DATABASE_ALLOW_PRODUCTION=0

# Gemini Configuration (Required for AI features)
# Get your API key from: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY is accepted as an alternative to GEMINI_API_KEY.
GEMINI_API_KEY=replace-with-gemini-api-key
GOOGLE_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# Request body limits
BODY_LIMIT=100kb

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=60
