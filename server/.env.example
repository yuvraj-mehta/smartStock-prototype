# Copy this file to .env for local development.

# Database Configuration
MONGO_URI=mongodb://localhost:27017/smartstock
DB_NAME=smartstock

# Server Configuration
PORT=3500
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_EXPIRATION=7d

# Admin bootstrap
# Used by npm run seed:admin, npm run create-admin, and npm run seed.
ADMIN_EMAIL=admin@smartstock.local
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Admin User
ADMIN_PHONE=0000000000
ADMIN_WAREHOUSE_NAME=Admin Warehouse
ADMIN_WAREHOUSE_CAPACITY=10000
ADMIN_WAREHOUSE_UNIT=pcs
ADMIN_WAREHOUSE_STREET=123 Admin St
ADMIN_WAREHOUSE_CITY=Admin City
ADMIN_WAREHOUSE_STATE=Admin State
ADMIN_WAREHOUSE_ZIPCODE=00000
ADMIN_WAREHOUSE_COUNTRY=Adminland

# Product seed supplier
# Used by npm run seed:products and npm run seed.
SEED_SUPPLIER_NAME=SmartStock Seed Supplier
SEED_SUPPLIER_COMPANY=SmartStock Seed Supplies
SEED_SUPPLIER_EMAIL=supplier@smartstock.local
SEED_SUPPLIER_PASSWORD=seed-supplier123
SEED_SUPPLIER_PHONE=1111111111
SEED_SUPPLIER_ADDRESS=Seed supplier address
SEED_SUPPLIER_CONTACT=Seed Contact

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: Redis for caching (if implemented)
REDIS_URL=redis://localhost:6379

# Gemini Configuration (Required for AI features)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
