{
  "name": "server",
  "version": "1.0.0",
  "description": "server for SmartStock",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "npm run seed:products",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:products": "node scripts/seedProducts.js",
    "seed:admin:dev": "NODE_ENV=development ALLOW_DEV_SEED_CREDENTIALS=1 node scripts/seedAdmin.js",
    "seed:products:dev": "NODE_ENV=development ALLOW_DEV_SEED_CREDENTIALS=1 node scripts/seedProducts.js",
    "seed:dev": "npm run seed:products:dev",
    "seed:demo-usage:dev": "NODE_ENV=development ALLOW_DEV_SEED_CREDENTIALS=1 node scripts/seedDemoUsage.js",
    "create-admin": "npm run seed:admin",
    "db:clear:dry-run": "node clearDatabase.js --dry-run",
    "db:clear": "node clearDatabase.js --execute",
    "count:delivered": "node scripts/countDeliveredItems.js",
    "fix:delivered": "node scripts/fixDeliveredItems.js"
  },
  "author": "Yuvraj Mehta",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.34.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "express": "^5.2.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.22.1",
    "node-cron": "^4.2.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.1.1",
    "nodemon": "^3.1.10",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "jest": "^30.0.4",
    "supertest": "^7.1.3"
  }
}
